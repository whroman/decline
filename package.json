{
  "name": "conjugate",
  "version": "0.3.19",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "app-e2e"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "BABEL_DISABLE_CACHE=1 mocha --compilers js:babel-register $(find ./generator ./app ./tables -name '*.spec.js')",
    "check:imports": "node ./tasks/checkImportCasing.mjs",
    "verify": "npm run check:imports && npm test",
    "test:e2e": "npm --workspace @decline/web-e2e test",
    "test:e2e:local": "npm run build && npm run test:e2e",
    "deploy:bootstrap:preview": "npm run build && wrangler deploy --env preview",
    "deploy:bootstrap:staging": "npm run build && wrangler deploy --env staging",
    "deploy:bootstrap:production": "npm run build && wrangler deploy --env production",
    "test:watch": "npm test -- --watch",
    "tdd": "npm run test:watch",
    "lint": "npm run lint:client && npm run lint:specs",
    "lint:client": "esw --ignore-pattern *.spec.js --config ./tasks/.eslintrc.client.js ./tables ./src ./tasks ./app ./generator",
    "lint:specs": "esw --config ./tasks/.eslintrc.mocha.js './tables/**/*.spec.js' './src/**/*.spec.js' './generator/**/*.spec.js'",
    "lint:watch": "run-p lint:watch:client lint:watch:specs",
    "lint:watch:client": "npm run lint:client -- --watch",
    "lint:watch:specs": "npm run lint:specs -- --watch"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "axios": "1.20.0",
    "foundation-sites": "6.9.0",
    "lodash": "4.18.1",
    "react": "19.2.8",
    "react-addons-css-transition-group": "15.6.2",
    "react-dom": "19.2.8",
    "react-dropdown": "2.0.0",
    "react-ga": "3.3.1",
    "react-redux": "9.3.0",
    "react-router": "8.3.1",
    "react-router-redux": "4.0.8",
    "redux": "5.0.1",
    "redux-actions": "3.0.3",
    "redux-logger": "3.0.6"
  },
  "devDependencies": {
    "babel-eslint": "10.1.0",
    "babel-plugin-lodash": "3.3.4",
    "babel-plugin-webpack-alias": "2.1.2",
    "babel-polyfill": "6.26.0",
    "babel-preset-es2016": "6.24.1",
    "babel-preset-react": "6.24.1",
    "babel-register": "6.26.0",
    "chai": "6.2.2",
    "eslint": "10.10.0",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-watch": "8.0.0",
    "mocha": "12.0.0",
    "npm-run-all": "4.1.5",
    "proxyquire": "2.1.3",
    "rewire": "9.0.1",
    "sass": "1.104.0",
    "sinon": "22.1.0",
    "vite": "8.2.2",
    "wrangler": "^4.102.0"
  }
}
