{
  "name": "conjugate",
  "version": "0.3.19",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "app-e2e"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "BABEL_DISABLE_CACHE=1 mocha --compilers js:babel-register $(find ./generator ./app ./tables -name '*.spec.js')",
    "check:imports": "node ./tasks/checkImportCasing.mjs",
    "architecture:check": "node --test architecture/*.spec.mjs",
    "verify": "npm run check:imports && npm run architecture:check && npm test",
    "test:e2e": "npm --workspace @decline/web-e2e test",
    "test:e2e:local": "npm run build && npm run test:e2e",
    "deploy:bootstrap:preview": "npm run build && wrangler deploy --env preview",
    "deploy:bootstrap:staging": "npm run build && wrangler deploy --env staging",
    "deploy:bootstrap:production": "npm run build && wrangler deploy --env production",
    "test:watch": "npm test -- --watch",
    "tdd": "npm run test:watch",
    "lint": "npm run lint:client && npm run lint:specs",
    "lint:client": "esw --ignore-pattern *.spec.js --config ./tasks/.eslintrc.client.js ./tables ./src ./tasks ./app ./generator",
    "lint:specs": "esw --config ./tasks/.eslintrc.mocha.js './tables/**/*.spec.js' './src/**/*.spec.js' './generator/**/*.spec.js'",
    "lint:watch": "run-p lint:watch:client lint:watch:specs",
    "lint:watch:client": "npm run lint:client -- --watch",
    "lint:watch:specs": "npm run lint:specs -- --watch"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "axios": "0.11.0",
    "foundation-sites": "6.2.1",
    "lodash": "4.12.0",
    "react": "15.1.0",
    "react-addons-css-transition-group": "15.1.0",
    "react-dom": "15.1.0",
    "react-dropdown": "1.0.4",
    "react-ga": "2.1.0",
    "react-redux": "4.4.5",
    "react-router": "2.4.0",
    "react-router-redux": "4.0.4",
    "redux": "3.5.2",
    "redux-actions": "0.9.1",
    "redux-logger": "2.6.1"
  },
  "devDependencies": {
    "babel-eslint": "6.0.4",
    "babel-plugin-lodash": "3.1.4",
    "babel-plugin-webpack-alias": "1.3.1",
    "babel-polyfill": "6.8.0",
    "babel-preset-es2016": "6.0.11",
    "babel-preset-react": "6.5.0",
    "babel-register": "6.9.0",
    "chai": "3.4.1",
    "eslint": "2.10.2",
    "eslint-plugin-babel": "3.2.0",
    "eslint-plugin-mocha": "2.2.0",
    "eslint-plugin-react": "5.1.1",
    "eslint-watch": "2.1.11",
    "jsonc-parser": "^3.3.1",
    "mocha": "2.3.4",
    "npm-run-all": "2.1.1",
    "proxyquire": "1.7.9",
    "rewire": "2.5.1",
    "sass": "1.104.0",
    "sinon": "1.17.4",
    "vite": "8.2.2",
    "wrangler": "^4.102.0",
    "yaml": "^2.9.0"
  }
}
