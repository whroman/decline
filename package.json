{
  "name": "conjugate",
  "version": "0.3.19",
  "description": "",
  "main": "index.js",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "BABEL_DISABLE_CACHE=1 mocha",
    "checks": "node tasks/checks/cli.mjs",
    "test:harness": "PNPM_BINARY=\"${PNPM_BINARY:-$(command -v pnpm)}\" node --test --test-reporter spec --test-reporter-destination stdout --test-reporter ./tasks/checks/node-reporter.mjs --test-reporter-destination stdout tasks/checks/*.spec.mjs",
    "check:imports": "node ./tasks/checkImportCasing.mjs",
    "architecture:check": "node --test --test-reporter spec --test-reporter-destination stdout --test-reporter ./tasks/checks/node-reporter.mjs --test-reporter-destination stdout architecture/*.spec.mjs",
    "verify": "pnpm run --no-bail --sequential \"/^(architecture:check|test|test:harness)$/\"",
    "test:e2e": "pnpm --filter @decline/web-e2e test",
    "test:e2e:local": "pnpm run build && pnpm run test:e2e",
    "deploy:bootstrap:preview": "pnpm run build && wrangler deploy --env preview",
    "deploy:bootstrap:staging": "pnpm run build && wrangler deploy --env staging",
    "deploy:bootstrap:production": "pnpm run build && wrangler deploy --env production",
    "test:watch": "pnpm test --watch",
    "tdd": "pnpm run test:watch",
    "lint": "pnpm run lint:client && pnpm run lint:specs",
    "lint:client": "esw --ignore-pattern *.spec.js --config ./tasks/.eslintrc.client.js ./tables ./src ./tasks ./app ./generator",
    "lint:specs": "esw --config ./tasks/.eslintrc.mocha.js './tables/**/*.spec.js' './src/**/*.spec.js' './generator/**/*.spec.js'",
    "lint:watch": "pnpm run \"/^lint:watch:(client|specs)$/\"",
    "lint:watch:client": "pnpm run lint:client --watch",
    "lint:watch:specs": "pnpm run lint:specs --watch"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "axios": "0.11.0",
    "foundation-sites": "6.2.1",
    "lodash": "4.12.0",
    "react": "15.1.0",
    "react-addons-css-transition-group": "15.1.0",
    "react-dom": "15.1.0",
    "react-dropdown": "1.0.4",
    "react-ga": "2.1.0",
    "react-redux": "4.4.5",
    "react-router": "2.4.0",
    "react-router-redux": "4.0.4",
    "redux": "3.5.2",
    "redux-actions": "0.9.1",
    "redux-logger": "2.6.1"
  },
  "devDependencies": {
    "allure": "^3.17.0",
    "allure-mocha": "^3.12.1",
    "allure-node-test": "^3.12.1",
    "babel-eslint": "6.0.4",
    "babel-plugin-lodash": "3.1.4",
    "babel-plugin-webpack-alias": "1.3.1",
    "babel-polyfill": "6.8.0",
    "babel-preset-es2016": "6.0.11",
    "babel-preset-react": "6.5.0",
    "babel-register": "6.9.0",
    "chai": "3.4.1",
    "eslint": "2.10.2",
    "eslint-plugin-babel": "3.2.0",
    "eslint-plugin-mocha": "2.2.0",
    "eslint-plugin-react": "5.1.1",
    "eslint-watch": "2.1.11",
    "jsonc-parser": "^3.3.1",
    "mocha": "^12.0.0",
    "proxyquire": "1.7.9",
    "sass": "1.104.0",
    "sinon": "1.17.4",
    "vite": "8.2.2",
    "wrangler": "^4.102.0",
    "yaml": "^2.9.0"
  }
}
