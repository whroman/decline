{
  "elements": {
    "app.web": {
      "kind": "deployable",
      "description": "Browser SPA",
      "implementation": {
        "paths": [
          "app",
          "generator",
          "tables",
          "index.html",
          "vite.config.mjs"
        ]
      },
      "delivery": {
        "platform": "cloudflare-workers-static-assets",
        "workflow": {
          "preview": ".github/workflows/web-preview.yaml",
          "release": ".github/workflows/web-release.yaml"
        },
        "architecture": [
          "architecture/frontend-delivery-architecture.md"
        ]
      },
      "runtime": {
        "cloudflare": {
          "baseWorkerName": "decline-web",
          "environments": {
            "preview": "decline-web-preview",
            "staging": "decline-web-staging",
            "production": "decline-web-production"
          }
        }
      }
    }
  }
}
